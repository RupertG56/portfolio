<UserControl x:Class="AdminApp.SiteViewEditControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AdminApp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
	<Grid>
		<!-- Display Mode -->
		<Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Inverted}">
			<StackPanel>
				<TextBlock Text="{Binding Name}" />
				<TextBlock Text="{Binding Email}" />
				<!-- Other display fields -->
				<Button Command="{Binding EditCommand}" Content="Edit" />
			</StackPanel>
		</Grid>

		<!-- Edit Mode -->
		<Grid Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
			<StackPanel>
				<TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
				<TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />
				<!-- Other editable fields -->
				<StackPanel Orientation="Horizontal">
					<Button Command="{Binding SaveCommand}" Content="Save" />
					<Button Command="{Binding CancelCommand}" Content="Cancel" />
				</StackPanel>
			</StackPanel>
		</Grid>
	</Grid>
</UserControl>
