<UserControl x:Class="Portfolio.AdminApp.Controls.SiteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Portfolio.AdminApp"
			 xmlns:vm="clr-namespace:Portfolio.AdminApp.ViewModel"
			 xmlns:controls="clr-namespace:Portfolio.AdminApp.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="800"
			 d:DataContext="{d:DesignInstance Type=vm:SiteViewModel, IsDesignTimeCreatable=True}">
	<UserControl.Resources>
		<!-- Framework converter used to swap controls dynamically -->
		<BooleanToVisibilityConverter x:Key="BoolToVis" />
	</UserControl.Resources>
	<b:Interaction.Triggers>
		<b:EventTrigger EventName="Loaded">
			<b:InvokeCommandAction Command="{Binding LoadSiteDataCommand}" />
		</b:EventTrigger>
	</b:Interaction.Triggers>

	<Grid Margin="20">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<!-- Fields -->
			<RowDefinition Height="Auto"/>
			<!-- Actions Panel -->
		</Grid.RowDefinitions>

		<!-- DATA FORM LAYER -->
		<StackPanel Grid.Row="0">
			<!-- Title Field -->
			<Label Content="Title:"/>
			<Grid>
				<TextBlock Text="{Binding SiteTitle}" FontSize="14" Margin="5"
                           Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
				<TextBox Text="{Binding SiteTitle, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
			</Grid>

			<!-- Tag Line Field -->
			<Label Content="Tag Line:"/>
			<Grid>
				<TextBlock Text="{Binding TagLine}" FontSize="14" Margin="5"
                           Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
				<TextBox Text="{Binding TagLine, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
			</Grid>
		</StackPanel>
		<StackPanel Grid.Row="1">
			<Label Content="Resume URL:"/>
			<Grid>
				<TextBlock Text="{Binding SiteResumeUrl}" FontSize="14" Margin="5"
                           Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
				<TextBox Text="{Binding SiteResumeUrl, UpdateSourceTrigger=PropertyChanged}"
                         Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
			</Grid>
		</StackPanel>
		<StackPanel Grid.Row="2">
			<GroupBox Header="Contact Information">
				<StackPanel>
					<Label Content="Email:"/>
					<Grid>
						<TextBlock Text="{Binding SiteEmail}" FontSize="14" Margin="5"
								   Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
						<TextBox Text="{Binding SiteEmail, UpdateSourceTrigger=PropertyChanged}"
								 Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
					</Grid>

					<Label Content="Phone:"/>
					<Grid>
						<TextBlock Text="{Binding SitePhone}" FontSize="14" Margin="5"
								   Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
						<TextBox Text="{Binding SitePhone, UpdateSourceTrigger=PropertyChanged}"
								 Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
					</Grid>

					<Label Content="Address:"/>
					<Grid>
						<TextBlock Text="{Binding SiteAddressStreet}" FontSize="14" Margin="5"
								   Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
						<TextBox Text="{Binding SiteAddressStreet, UpdateSourceTrigger=PropertyChanged}"
								 Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
					</Grid>
					<Grid>
						<TextBlock Text="{Binding SiteAddressCity}" FontSize="14" Margin="5"
								   Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
						<TextBox Text="{Binding SiteAddressCity, UpdateSourceTrigger=PropertyChanged}"
								 Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
					</Grid>
					<Grid>
						<TextBlock Text="{Binding SiteAddressState}" FontSize="14" Margin="5"
								   Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
						<TextBox Text="{Binding SiteAddressState, UpdateSourceTrigger=PropertyChanged}"
								 Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
					</Grid>
					<Grid>
						<TextBlock Text="{Binding SiteAddressZip}" FontSize="14" Margin="5"
								   Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}"/>
						<TextBox Text="{Binding SiteAddressZip, UpdateSourceTrigger=PropertyChanged}"
								 Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}"/>
					</Grid>
				</StackPanel>
			</GroupBox>
		</StackPanel>

		<!-- ACTION LAYER (Swaps out buttons conditionally) -->
		<StackPanel Grid.Row="3" Margin="0,20,0,0">

			<!-- View Mode Controls -->
			<StackPanel Orientation="Horizontal" Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}">
				<Button Content="Edit Details" Command="{Binding SwitchToEditModeCommand}" Width="100" Height="30"/>
			</StackPanel>

			<!-- Edit Mode Controls -->
			<StackPanel Orientation="Horizontal" Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}">
				<Button Content="Save" Command="{Binding SaveChangesCommand}" Width="100" Height="30" Margin="0,0,10,0"/>
				<Button Content="Cancel" Command="{Binding CancelEditCommand}" Width="100" Height="30"/>
			</StackPanel>

		</StackPanel>
	</Grid>
</UserControl>
