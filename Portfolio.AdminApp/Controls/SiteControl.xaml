<UserControl x:Class="Portfolio.AdminApp.Controls.SiteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Portfolio.AdminApp.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="800"
             d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=vm:SiteViewModel, IsDesignTimeCreatable=True}"
             Background="#F4F6FA"
             FontFamily="Segoe UI">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#182230" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#667085" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="ReadValueStyle" TargetType="TextBlock">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="11,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#182230" />
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Visibility"
                    Value="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}" />
        </Style>

        <Style x:Key="EditorStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#182230" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Visibility"
                    Value="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}" />
        </Style>

        <Style x:Key="ButtonBaseStyle" TargetType="Button">
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="BorderBrush" Value="#2563EB" />
        </Style>

        <Style x:Key="SecondaryButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource ButtonBaseStyle}">
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
        </Style>
    </UserControl.Resources>

    <b:Interaction.Triggers>
        <b:EventTrigger EventName="Loaded">
            <b:InvokeCommandAction Command="{Binding LoadSiteDataCommand}" />
        </b:EventTrigger>
    </b:Interaction.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="920" Margin="32,28,32,36">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Site settings"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Foreground="#101828" />
                    <TextBlock Text="Manage the content displayed on your portfolio."
                               Margin="0,6,0,0"
                               FontSize="14"
                               Foreground="#667085" />
                </StackPanel>

                <Border Grid.Column="1"
                        Padding="10,5"
                        CornerRadius="12"
                        Background="#ECFDF3"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Viewing"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#027A48" />
                </Border>

                <Border Grid.Column="1"
                        Padding="10,5"
                        CornerRadius="12"
                        Background="#EFF6FF"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Editing"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#1D4ED8" />
                </Border>
            </Grid>

            <Border Grid.Row="1"
                    Margin="0,0,0,18"
                    Padding="24"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="General information"
                               Style="{StaticResource SectionTitleStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
                            <TextBlock Text="SITE TITLE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SiteTitle}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding SiteTitle, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
                            <TextBlock Text="TAGLINE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding TagLine}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding TagLine, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3">
                            <TextBlock Text="RESUME URL" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SiteResumeUrl}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding SiteResumeUrl, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Margin="0,0,0,18"
                    Padding="24"
                    Background="White"
                    BorderBrush="#E4E7EC"
                    BorderThickness="1"
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Contact information"
                               Style="{StaticResource SectionTitleStyle}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,18">
                            <TextBlock Text="EMAIL" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SiteEmail}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding SiteEmail, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,18">
                            <TextBlock Text="PHONE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SitePhone}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding SitePhone, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="3"
                                    Margin="0,0,0,18">
                            <TextBlock Text="STREET ADDRESS" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SiteAddressStreet}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding SiteAddressStreet, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,0,18">
                            <TextBlock Text="CITY" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SiteAddressCity}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding SiteAddressCity, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,18">
                            <TextBlock Text="STATE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SiteAddressState}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding SiteAddressState, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>

                        <StackPanel Grid.Row="3" Grid.Column="0">
                            <TextBlock Text="ZIP CODE" Style="{StaticResource FieldLabelStyle}" />
                            <TextBlock Text="{Binding SiteAddressZip}" Style="{StaticResource ReadValueStyle}" />
                            <TextBox Text="{Binding SiteAddressZip, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource EditorStyle}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3">
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsInViewMode, Converter={StaticResource BoolToVis}}">
                    <Button Content="Edit details"
                            Command="{Binding SwitchToEditModeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Visibility="{Binding IsInEditMode, Converter={StaticResource BoolToVis}}">
                    <Button Content="Cancel"
                            Command="{Binding CancelEditCommand}"
                            Margin="0,0,10,0"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Content="Save changes"
                            Command="{Binding SaveChangesCommand}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
